# 后端地址 —— 联调时填入队友的腾讯云公网地址（hackathon-plan §4.2）
# 不填 = 全 mock 模式，前端可独立开发演示

BACKEND_URL=https://video-chat-ai-5-people-group.icu            # Next.js 服务端同源代理
NEXT_PUBLIC_BACKEND_URL=https://video-chat-ai-5-people-group.icu # 启用真后端；后续 iOS 直连也复用
# 仅限黑客松演示：认证 UI 接入前可填短期 token。NEXT_PUBLIC_ 会进入浏览器包，不可放长期密钥。
NEXT_PUBLIC_BACKEND_ACCESS_TOKEN=

# OSS credentials are server-only. Never add a NEXT_PUBLIC_ prefix.
# Provide OSS_STS_TOKEN as well when using temporary STS credentials.
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_STS_TOKEN=
OSS_REGION=
OSS_BUCKET=
OSS_ENDPOINT=
OSS_VIDEO_OBJECT_KEY=
OSS_SIGNED_URL_EXPIRES_SECONDS=3600

# The browser fetches a short-lived playback URL from /api/oss/playback.

# AIGC(人设提取 + 群聊发言)—— 服务端专用,绝不加 NEXT_PUBLIC_ 前缀
# OpenAI 兼容格式:POST {LLM_BASE_URL}/chat/completions + Bearer <key>
# 不配或调用失败 = 这两个环节自动回退 mock;线上部署填到平台的环境变量里即可
LLM_BASE_URL=                # 平台接入点,形如 https://xxx.com/v1
LLM_MODEL=                   # 模型 ID,按平台模型列表填(建议 kimi-k2.5;kimi-k3 是 reasoning 模型,单轮 30s+ 不适合对话)
LLM_API_KEYS=                # 逗号分隔的 key;第 i 个故事角色用第 i 个 key
